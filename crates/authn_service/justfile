export CARGO_TARGET_DIR := "../../target"
set dotenv-load

localhost := "localhost"

# List available commands
help:
    @just --list --unsorted --list-heading $'🔐AUTHN-SERVICE\n'

# Run lints (cargo fmt and clippy)
lint:
    cargo +nightly fmt --package authn_service -- --check
    cargo clippy --all-targets -- -D warnings

# Run cargo check
check:
    cargo check

# Run cargo build
build:
    cargo build --all-targets

# Run cargo clean on the authn_service package
clean:
    cargo clean --package authn_service

# Run cargo test
test:
    cargo test

# Run server app
app:
    DB_HOST={{ localhost }} CACHE_HOST={{ localhost }} NATS_HOST={{ localhost }} \
    cargo run --bin app

# Run DB migration CLI
migration *cmd:
    DB_HOST={{ localhost }} \
    cargo run --bin migration -- migration {{ cmd }}

# Generate openapi.yaml
apidoc:
    cargo run --bin apidoc

# Set NATS context
nats-context:
    @ nats context add authn --server localhost:4222 --user admin --password 0b0296e1ae6b8c77
    @ echo "⚠️ Add 'export NATS_CONTEXT=\"authn\"' to your ~/.zshrc or ~/.bashrc"

# Setup NATS
nats-setup:
    nats stream add authn --subjects "authn.email.verification,authn.email.new_device,authn.email.change_password" --retention=work --discard=new --defaults

## =========================================================================

# Run docker commands
docker *cmd:
    docker {{ cmd }}

# Build production distroless image
build-for-prod:
    docker build --build-context workspace_root=../../ -t authn-service-app -f prod.Dockerfile .