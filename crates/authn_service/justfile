export CARGO_TARGET_DIR := "../../target"
set dotenv-load

localhost := "localhost"

# List available commands
help:
    @just --list --unsorted --list-heading $'🔐AUTHN-SERVICE\n'

# Run lints (cargo fmt and clippy)
lint:
    cargo +nightly fmt --package authn_service -- --check
    cargo clippy --all-targets -- -D warnings

# Run cargo check
check:
    cargo check

# Run cargo build
build:
    cargo build --all-targets

# Run cargo clean on the authn_service package
clean:
    cargo clean --package authn_service

# Run cargo test
test:
    cargo test

# Run server app
app:
    DB_HOST={{ localhost }} CACHE_HOST={{ localhost }} NATS_HOST={{ localhost }} \
    cargo run --bin app

# Run DB migration CLI
migration *cmd:
    DB_HOST={{ localhost }} \
    cargo run --bin migration -- migration {{ cmd }}

# Generate openapi.yaml
apidoc:
    cargo run --bin apidoc

# Set NATS context
nats-context:
    nats context save sys --server localhost:4222 --user root --password 2efbe41f2bbe7507e6b54d7d90937c5c
    echo "⚠️ Add 'export NATS_CONTEXT=\"sys\"' to your ~/.zshrc or ~/.bashrc"

# Setup NATS
nats-setup:
    nats stream edit notify --subjects "notify.email.authn.verification,notify.email.authn.new_device,notify.email.authn.change_password"

## =========================================================================

# Run docker commands
docker *cmd:
    docker {{ cmd }}

# Build production distroless image
build-for-prod:
    docker build --build-context workspace_root=../../ -t authn-service-app -f prod.Dockerfile .